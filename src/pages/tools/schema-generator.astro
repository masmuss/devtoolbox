---
import PageHeader from "@/components/layouts/PageHeader.astro";
import SchemaGeneratorComponent from "@/components/tools/schema-generator";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
	title="Database Schema Generator"
	description="Instantly convert JSON objects into SQL Tables, Prisma Models, or Mongoose Schemas through intelligent type inference."
>
	<main class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
		<PageHeader
			title="Database Schema Generator"
			description="Paste a JSON response or data array and let the tool automatically infer the data types, constraints, and relationships for PostgreSQL, MySQL, Prisma, or MongoDB."
		/>

		<SchemaGeneratorComponent client:load />
	</main>
</BaseLayout>
