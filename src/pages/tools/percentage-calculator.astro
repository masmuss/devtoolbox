---
import PageHeader from "@/components/layouts/PageHeader.astro";
import PercentageCalculatorComponent from "@/components/tools/percentage-calculator";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
	title="Percentage Calculator"
	description="Calculate percentages, percentage changes, and ratios"
>
	<main class="mx-auto max-w-5xl px-6 py-12 lg:px-8">
		<PageHeader
			title="Percentage Calculator"
			description="Easily calculate what Y% of a number is, find the percentage of a value, or determine the percentage increase or decrease between two numbers."
		/>

		<PercentageCalculatorComponent client:load />
	</main>
</BaseLayout>
