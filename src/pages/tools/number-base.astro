---
import PageHeader from "@/components/layouts/PageHeader.astro";
import NumberBaseConverterComponent from "@/components/tools/number-base-converter";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
	title="Number Base Converter"
	description="Convert numbers between binary, decimal, hexadecimal, and octal bases."
>
	<main class="mx-auto max-w-5xl px-6 py-12 lg:px-8">
		<PageHeader
			title="Number Base Converter"
			description="Easily convert numbers between Binary (Base 2), Octal (Base 8), Decimal (Base 10), and Hexadecimal (Base 16)."
		/>

		<NumberBaseConverterComponent client:load />
	</main>
</BaseLayout>
